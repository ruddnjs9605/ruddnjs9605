# 필수: Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 선택: 인터넷에 공개 배포할 때 다른 사람이 못 쓰게 막는 비밀번호
APP_PASSWORD=

# 선택: 인스타그램 자동 게시 (비즈니스/크리에이터 계정 + Graph API 토큰 필요)
IG_USER_ID=
IG_ACCESS_TOKEN=
# 인스타그램이 이미지를 내려받을 수 있는 이 서버의 공개 HTTPS 주소
PUBLIC_BASE_URL=
# Instagram 로그인 방식 토큰이면 https://graph.instagram.com/v21.0 로 바꾸세요
IG_GRAPH_BASE=https://graph.facebook.com/v21.0
